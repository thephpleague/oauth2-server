parameters:
    level: 8
    paths:
        - src
        - tests
    ignoreErrors:
        # Preserve support for tokens without exp; PermissiveValidAt would reject them.
        -
            message: '#deprecated class Lcobucci\\JWT\\Validation\\Constraint\\LooseValidAt#'
            path: src/AuthorizationValidators/BearerTokenValidator.php
            reportUnmatched: false
